[sub_resource type="GDScript" id="GDScript_bwqfa"]
script/source = "extends Control

@onready var text_label = $MarginContainer/Panel/VBoxContainer/RichTextLabel

var full_text := \"\"
var is_typing := false
var can_continue := false

@export var displayed_text := \"\":
	set(value):
		displayed_text = value

		if text_label:
			text_label.text = value

func show_dialog(text: String):

	visible = true

	full_text = text
	text_label.text = \"\"

	is_typing = true
	can_continue = false

	type_text()


func type_text() -> void:

	for char in full_text:

		# kalau player skip typing
		if !is_typing:
			text_label.text = full_text
			break

		text_label.text += char

		await get_tree().create_timer(0.03).timeout

	is_typing = false
	can_continue = true


func _unhandled_input(event):

	# mouse kiri atau ui_accept
	if event.is_action_pressed(\"ui_accept\") \\
	or event.is_action_pressed(\"mouse_click\"):

		# kalau masih mengetik → langsung tampil semua
		if is_typing:

			is_typing = false

		# kalau sudah selesai → lanjut dialog
		elif can_continue:

			hide_dialog()


func hide_dialog():

	visible = false
"

